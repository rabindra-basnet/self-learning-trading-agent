# Copy to .env for local development. NEVER commit .env.
APP_ENV=dev
LOG_LEVEL=INFO

# Auth
JWT_SECRET=change-me-32-chars-minimum
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://trading:trading@localhost:5432/trading

# ClickHouse
CLICKHOUSE_URL=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=trading

# Redis / Event bus
REDIS_URL=redis://localhost:6379/0
EVENT_BUS=in_memory   # in_memory | redis_streams

# Market data provider (the single knob that swaps providers)
MARKET_DATA_PROVIDER=binance
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_BASE_URL=https://api.binance.com
BINANCE_RATE_PER_SEC=5
BINANCE_TIMEOUT_SEC=10
BINANCE_RETRIES=3

# LLM provider (opencode.ai/zen free models by default)
LLM_PROVIDER=zen
LLM_BASE_URL=https://opencode.ai/zen/v1
LLM_MODEL=nemotron-3-ultra-free
OPENCODE_API_KEY=