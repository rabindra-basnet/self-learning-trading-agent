# Copy to .env for local development. NEVER commit .env.
# Flat, single-underscore env keys (no nested delimiter).
APP_ENV=dev
LOG_LEVEL=INFO

# Auth
AUTH_JWT_SECRET=change-me-32-chars-minimum
AUTH_JWT_ALG=HS256
AUTH_ACCESS_TTL_MIN=15
AUTH_REFRESH_TTL_DAYS=7

# PostgreSQL (identity store; `auth` schema tables must exist)
DATABASE_URL=postgresql+asyncpg://trading:trading@localhost:5432/trading

# ClickHouse (candle store)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=trading
CLICKHOUSE_SECURE=false

# Redis / Event bus (redis_streams is the only real bus)
REDIS_URL=redis://localhost:6379/0
EVENT_BUS=redis_streams

# Market data provider (the single knob that swaps providers).
# Each vendor owns its own prefixed block (docs/INTEGRATION-ARCHITECTURE.md §6);
# the composition root resolves it via the provider registry.
MARKET_DATA_PROVIDER=binance
MARKET_DATA_BINANCE_BASE_URL=https://api.binance.com
MARKET_DATA_BINANCE_API_KEY=
MARKET_DATA_BINANCE_API_SECRET=
MARKET_DATA_BINANCE_RATE_PER_SEC=5
MARKET_DATA_BINANCE_TIMEOUT_SEC=10
MARKET_DATA_BINANCE_RETRIES=3
MARKET_DATA_BINANCE_BACKOFF_BASE_SEC=0.5
MARKET_DATA_BINANCE_CIRCUIT_OPEN_AFTER=5
# MARKET_DATA_KRAKEN_API_KEY= ...   (added with the kraken boundary package)

# LLM provider (opencode.ai/zen free models by default)
LLM_PROVIDER=zen
LLM_BASE_URL=https://opencode.ai/zen/v1
LLM_MODEL=nemotron-3-ultra-free
LLM_API_KEY=
LLM_TIMEOUT_SEC=60
LLM_RETRIES=3

# Self-improvement event loop (`uv run python -m app.workers.runner`)
SELF_IMPROVE_ENABLED=false
SELF_IMPROVE_ROUND_INTERVAL_SEC=300
SELF_IMPROVE_MAX_STALE_ROUNDS=3
SELF_IMPROVE_MAX_ROUNDS=
SELF_IMPROVE_SYMBOL=BTC/USDT
SELF_IMPROVE_TIMEFRAME=1h
SELF_IMPROVE_LOOKBACK_DAYS=60
